{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "makruk",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME_ROOM", "class_name": "GameRoom" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "makruk",
      "database_id": "9e084ac6-9749-411d-867d-c89e8421ed78",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RECONNECT_GRACE_MS": "60000",
    "PUBLIC_ORIGIN": "https://th-chess.beanroti.com",
    // Sender for confirmation and reset emails (Resend, beanroti.com). Email stays off until the
    // RESEND_API_KEY secret is set.
    "EMAIL_FROM": "หมากรุกไทย <noreply@beanroti.com>"
  },
  "routes": [{ "pattern": "th-chess.beanroti.com", "custom_domain": true }],
  "observability": { "enabled": true }
}
